# network/nas/.env.sample → скопировать в network/nas/.env на NAS (Armbian)
# Значения tailnet konotop. НЕ коммитить реальный .env.

# Tailnet-IP konotop (из `tailscale ip -4` на konotop).
KONOTOP_TS_IP=100.65.92.104

# MagicDNS-имя konotop для TLS-проверки сертификата Tailscale Serve.
KONOTOP_HOST=konotop.tailb4dba1.ts.net

# LAN-IP NAS. Закрепить DHCP reservation на роутере, чтобы адрес не менялся.
NAS_LAN_IP=192.168.68.59

# LAN-порты NAS, которые открываются рабочему ноуту (в его локальной сети).
# Проверено свободным; службы NAS слушают только на NAS_LAN_IP.
PANEL_PORT=8095
SSH_RELAY_PORT=2222
SOCKS_PORT=1080
